# Release image. CD overrides IMAGE_TAG with the tested Git commit SHA.
BACKEND_IMAGE=tinh08042005/auction-backend
IMAGE_TAG=replace-with-git-sha

# Must be the exact volume currently mounted at /var/lib/postgresql/data.
POSTGRES_VOLUME_NAME=replace-with-existing-volume-name
POSTGRES_CONTAINER_NAME=postgres_auction
POSTGRES_IMAGE=postgres:15-alpine
POSTGRES_DB=auctiondb
POSTGRES_USER=root
POSTGRES_PASSWORD=replace-with-strong-password

REDIS_IMAGE=redis:7-alpine
REDIS_VOLUME_NAME=auctionplatform_redis_data
# Use letters, digits, underscores and hyphens because this is embedded in a URL.
REDIS_PASSWORD=replace-with-url-safe-password
REDIS_DATABASE=1

NGINX_IMAGE=nginx:1.27-alpine
APP_ENV_FILE=/srv/auction/.env

# Keep disabled until V1/V2 have passed a restore rehearsal.
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=0

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://replace-with-vercel-or-custom-domain
JWT_SIGNER_KEY=replace-with-at-least-64-random-bytes

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_ENABLED=false
FIREBASE_CONFIG_PATH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

FPTAI_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_API_URL=
VNPAY_RETURN_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=
MOMO_RETURN_URL=
MOMO_NOTIFY_URL=
